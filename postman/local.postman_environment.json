      "value": "6f1c2a3b-4d5e-4f60-8a7b-9c0d1e2f3a4b",
      "type": "default",
      "enabled": true,
      "description": "UUID of this Postman device. Signing in again with the same id replaces its token."
    },
    {
      "key": "code",
      "value": "000000",
      "type": "default",
      "enabled": true,
      "description": "Emailed code. 000000 works only with AUTH_TEST_MODE=true; otherwise read it in storage/logs/laravel.log."
