      "value": "test@example.com",
      "type": "default",
      "enabled": true,
      "description": "Account address used by every auth request."
    },
    {
      "key": "password",
      "value": "correct horse",
      "type": "secret",
      "enabled": true,
      "description": "Account password (at least 8 characters)."
    },
    {
      "key": "new_password",
      "value": "new correct horse",
      "type": "secret",
      "enabled": true,
      "description": "Password set by Reset password."
    },
    {
      "key": "terms_version",
      "value": "2026-11",
      "type": "default",
      "enabled": true,
      "description": "Must equal TERMS_VERSION in .env."
    },
    {
      "key": "locale",
      "value": "fr",
      "type": "default",
      "enabled": true,
      "description": "Account language: fr or en."
    },
    {
