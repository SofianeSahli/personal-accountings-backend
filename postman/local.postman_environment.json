      "enabled": true,
      "description": "Google ID token. test:<email> works only with AUTH_TEST_MODE=true."
    },
    {
      "key": "token",
      "value": "",
      "type": "secret",
      "enabled": true,
      "description": "Bearer token. Filled automatically by sign-in responses."
    },
    {
      "key": "pending_sign_in",
      "value": "",
