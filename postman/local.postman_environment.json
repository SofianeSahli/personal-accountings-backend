      "type": "default",
      "enabled": true,
      "description": "API root. Change the port if APP_FORWARD_PORT is not 8000."
    },
    {
      "key": "name",
      "value": "Test User",
      "type": "default",
      "enabled": true,
      "description": "Name used at sign-up."
    },
    {
