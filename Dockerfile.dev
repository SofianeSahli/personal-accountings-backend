FROM php:8.4.27-fpm-alpine

COPY --from=composer:2.11.2 /usr/bin/composer /usr/bin/composer
COPY --from=mlocati/php-extension-installer:2.13.2 /usr/bin/install-php-extensions /usr/local/bin/

RUN install-php-extensions intl opcache pcntl pdo_mysql zip

COPY docker/php/app.ini /usr/local/etc/php/conf.d/zz-app.ini

ENV COMPOSER_MEMORY_LIMIT=-1

WORKDIR /var/www

COPY composer.json composer.lock ./

RUN composer install \
    --no-interaction \
    --no-progress \
    --no-scripts \
    --no-autoloader

COPY . .

RUN composer dump-autoload --optimize \
    && chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

EXPOSE 9000

CMD ["php-fpm"]
